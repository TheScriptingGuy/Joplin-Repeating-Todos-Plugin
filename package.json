{
  "name": "joplin-plugin-repeating-to-dos-v2",
  "author": "TheScriptingGuy",
  "description": "A Joplin plugin to create repeating to-dos (version 2)",
  "version": "1.1.1",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "prepare": "npm run dist",
    "update": "npm install -g generator-joplin && yo joplin --node-package-manager npm --update --force",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "test": "jest",
    "test:watch": "jest --watch",
    "setup:e2e": "bash scripts/setup-e2e.sh",
    "test:e2e": "npm run dist && npm run setup:e2e && xvfb-run -a playwright test"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin",
    "joplin",
    "to-do",
    "repeat",
    "repeating",
    "recurring",
    "reccur"
  ],
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@playwright/test": "^1.60.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.7.13",
    "babel-loader": "^10.0.0",
    "babel-plugin-function-try-catch": "^1.1.0",
    "babel-plugin-try-catch-wrapper": "^0.2.2",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^11.0.0",
    "esbuild-loader": "^4.4.0",
    "fs-extra": "^10.1.0",
    "glob": "^8.0.3",
    "jest": "^29.7.0",
    "on-build-webpack": "^0.1.0",
    "playwright": "^1.60.0",
    "raw-loader": "^4.0.2",
    "speed-measure-webpack-plugin": "^1.5.0",
    "tar": "^6.1.11",
    "thread-loader": "^4.0.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "yargs": "^16.2.0"
  },
  "dependencies": {
    "browserify": "^17.0.0",
    "date-fns": "^2.20.0",
    "js-yaml": "^4.1.0",
    "reflect-metadata": "^0.1.13",
    "stream-browserify": "*",
    "typeorm": "^0.2.32"
  },
  "files": [
    "publish"
  ]
}
